# Copy this file outside the repository before use, then replace placeholders.
# Never commit the populated runtime file.
API_PORT=3001
API_HOST=0.0.0.0
VEMS_DB_HOST_PATH=C:/Users/REPLACE_ME/AppData/Local/VEMS/data
VEMS_DB_PATH=/var/lib/vems/data/windows-development.sqlite
VEMS_DB_INIT_MODE=fresh-development
VEMS_REQUIRE_EXISTING_DB=false
DB_ROOT_PASSWORD=replace-with-local-mysql-root-password
VTIGER_DB_PASSWORD=replace-with-local-vtiger-database-password
VTIGER_ADMIN_USER=admin
VTIGER_ADMIN_PASSWORD=replace-with-local-vtiger-admin-password
OPENEMR_DB_PASSWORD=replace-with-local-openemr-database-password
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=replace-with-local-openemr-admin-password
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
OPENEMR_BASE_URL=http://openemr
OPENEMR_TOKEN_URL=http://openemr/oauth2/default/token
OPENEMR_API_STYLE=standard
OPENEMR_GRANT_TYPE=password
OPENEMR_SCOPE=openid api:oemr user/patient.read user/patient.write user/encounter.read user/encounter.write user/vital.read user/vital.write user/soap_note.read user/soap_note.write user/medication.read
OPENEMR_CLIENT_ID=replace-with-local-openemr-client-id
OPENEMR_CLIENT_SECRET=replace-with-local-openemr-client-secret
OPENEMR_USERNAME=replace-with-local-openemr-username
OPENEMR_PASSWORD=replace-with-local-openemr-password
OPENEMR_USER_ROLE=users
VTIGER_BASE_URL=http://vtiger
VTIGER_USERNAME=replace-with-local-vtiger-username
VTIGER_PASSWORD=replace-with-local-vtiger-password
VTIGER_ACCESS_KEY=replace-with-local-vtiger-access-key
JWT_HS256_SECRET=replace-with-local-jwt-signing-secret
JWT_ISSUER=local-dev
JWT_AUDIENCE=vems-platform
VEMS_ENABLE_DEVELOPMENT_TEST_AUTH=false
VEMS_DEVELOPMENT_TEST_SESSION_TTL_SECONDS=3600
