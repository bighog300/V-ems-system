{
  "name": "v-ems-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "pretest": "npm run test:vtiger-contract",
    "test:vtiger-contract": "node --test infra/services/vtiger/field-ownership.test.mjs && node infra/services/vtiger/validate-field-ownership.mjs",
    "bootstrap": "./scripts/bootstrap.sh",
    "init-db": "./scripts/init-db.sh development",
    "start:env": "./scripts/start-env.sh development",
    "stop:env": "./scripts/stop-env.sh",
    "smoke": "./scripts/smoke.sh development",
    "perf:load": "node ./scripts/load-test-api.mjs",
    "perf:load:sync-worker": "node ./scripts/load-test-sync-worker.mjs",
    "lint": "node ./scripts/lint.mjs"
  }
}
